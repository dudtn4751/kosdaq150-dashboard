# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요. .env는 .gitignore에 등록되어 있습니다.

# Anthropic Claude API 키 (필수 — 미국 이벤트 해석에 사용)
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-...

# 사용할 모델 (기본: claude-sonnet-4-6)
# 더 빠르고 저렴한 옵션: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
